# Copy to .env and fill in. The runner reads these and passes them into the
# benchmark container. .env is gitignored.

# API key for the hill-climbing model. Also used for evaluation and auditing,
# which run with Claude by default.
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you hill-climb with a Codex model preset.
OPENAI_API_KEY=sk-proj-...

# HuggingFace token. The benchmark image uses it to download the train/val
# split (hill-climb) or the held-out test split (evaluate) at container start.
HF_TOKEN=hf_...
